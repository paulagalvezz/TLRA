# Copy to .env and adjust. EASY-RAG runs locally with uv, or via docker compose.

# --- Chat model (writes the answers) ---
# OpenAI-compatible endpoint of your LLM. From this machine Ollama is reachable
# at the WSL/bridge IP below; use http://localhost:11434/v1 if Ollama runs locally.
# Under docker compose, keep this host IP (or see README for host.docker.internal).
LLM_BASE_URL=http://172.22.240.1:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen2.5vl:7b

# --- Embeddings model (turns chunks + queries into vectors) ---
# Reuses LLM_BASE_URL / LLM_API_KEY above; only the model name is separate.
# MUST stay the same across insert and query, or the geometry means nothing.
EMBED_MODEL=nomic-embed-text

# --- Retrieval (query side) ---
# Top-K nearest chunks pulled per turn, and the min cosine similarity to keep one.
# 0.5 is a starting point for nomic-embed-text (relevant ~0.50-0.70, unrelated
# ~0.40-0.50); calibrate to your model/corpus. If nothing passes, the assistant
# answers "I don't know" instead of using weak context. Empty = threshold off.
RETRIEVAL_TOP_K=4
SIMILARITY_THRESHOLD=0.5

# --- Chunking (ingest side; "paragraphs" strategy) ---
#CHUNK_STRATEGY=paragraphs
#PARAGRAPHS_PER_CHUNK=1        # paragraphs grouped into one chunk
#HEADING_LEVEL=2               # headings at level <= this delimit a chunk (2 = ## and #)
#CHUNK_SIZE_CHARS=800          # soft max chunk size; a paragraph is never cut
#CHUNK_OVERLAP_CHARS=100       # reserved for future char-window strategies

# --- Storage / behaviour ---
#COLLECTION_METRIC=cosine
#MAX_DOC_BYTES=102400
#STATIC_URL_PREFIX=/static
#STATIC_DIR=                   # default: data/static
#NO_HITS_MESSAGE=              # honest answer when nothing passes the threshold
